From 7d132eacb569394ed7ca7dc1e3f6632e260e83e9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 04:45:18 -0600
Subject: [PATCH] Regression: read the meshes from exact-models/

tests/ was renamed exact-models/; ThreeHoleBracket.STL is now
threeholebracket.STL; CrossHoles.stl and WedgeHoles.stl were removed
and are dropped from the list. 30 parts, all pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BdLZZ9vSNLZMXpfzfEFDKh
---
 regression/run_all.sh | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/regression/run_all.sh b/regression/run_all.sh
index 34456ec..e369fad 100755
--- a/regression/run_all.sh
+++ b/regression/run_all.sh
@@ -1,5 +1,5 @@
 #!/usr/bin/env bash
-# Regression run over the test meshes in tests/. Usage: regression/run_all.sh [outdir] [jobs]
+# Regression run over the meshes in exact-models/. Usage: regression/run_all.sh [outdir] [jobs]
 cd "$(dirname "$0")/.."
 OUT=${1:-/tmp/stl2cad_reg}
 JOBS=${2:-4}
@@ -16,7 +16,7 @@ Gear.STL mm
 AlcoaGrabCAD.stl in
 BicycleCrank.STL m
 CrankArm.STL in
-ThreeHoleBracket.STL m
+threeholebracket.STL m
 SwingArm.STL m
 SimpleBracket.STL m
 LBracket.STL m
@@ -27,8 +27,6 @@ HeatBlock.STL m
 C-bracket.STL m
 StepBlock.STL m
 slottedBlock.STL m
-WedgeHoles.stl mm
-CrossHoles.stl mm
 bottleopener.STL m
 lid.STL m
 hexspanner.STL m
@@ -45,7 +43,7 @@ run_one() {
   f=$1; u=$2; out=$3
   stem=${f%.*}
   start=$(date +%s)
-  timeout 900 python -m stl2cad.cli "tests/$f" --units "$u" -o "$out/$stem" > "$out/$stem.log" 2>&1
+  timeout 900 python -m stl2cad.cli "exact-models/$f" --units "$u" -o "$out/$stem" > "$out/$stem.log" 2>&1
   rc=$?
   echo "$stem rc=$rc t=$(( $(date +%s) - start ))s"
 }
