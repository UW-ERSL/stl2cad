+def ibeam(wt):
+    """I-beam in a 120 x 60 x 20 box, as cantilever Case 9: two flanges along x on y = 0 and y = 60 (depth
+    w = 20, thickness t = w / wt at x = 0, tapering to 0.6 t at x = 120), joined by a 3 mm web in the mid-plane
+    z = 10 with four round openings. Plates when w / t >= 1.5 everywhere."""
+    B = 60.0
+    t = H / wt
+    def flange(y0, s):
+        pts = [(0, y0), (L, y0), (L, y0 + s * 0.6 * t), (0, y0 + s * t)]
+        return cq.Workplane('XY').polyline(pts).close().extrude(H)
+    fl = flange(0, 1).union(flange(B, -1))
+    web = box(L, B, 3, 0, 0, H / 2 - 1.5)
+    for xc in (20.0, 50.0, 80.0, 105.0):
+        web = web.cut(cq.Workplane().add(cq.Solid.makeCylinder(min(12, B / 2 - t - 3), H, cq.Vector(xc, B / 2, 0))))
+    return box(L, B, H), fl.union(web).val(), dict(
+        regions=['2 tapered flanges, depth 20, thickness %.3g to %.3g' % (t, 0.6 * t), 'web 3 mm, 4 openings'],
+        w_over_t=[wt, wt / 0.6])
 
 
