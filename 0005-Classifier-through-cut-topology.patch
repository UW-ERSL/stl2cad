+def local_shape(V, K, rng):
+    """analyze.local_shape with separate limits: at a medial point, the principal axes (s1 >= s2 >= s3) of the TO
+    within SHAPE_R x r give rod when s2 / s1 < ROD_T, else plate when s3 / s2 < PLATE_T, else blob. A straight
+    member of section w x t with w / t about 2 (cantilever Case 9's flanges) falls between the limits: blob."""
+    T0 = analyze.SHAPE_T
+    try:
+        analyze.SHAPE_T = None
+        return _local_shape(V, K, rng)
+    finally:
+        analyze.SHAPE_T = T0
+
+
+def _local_shape(V, K, rng):
+    import math
+    from scipy.spatial import cKDTree
+    DT = ndi.distance_transform_edt(np.pad(V, 1))[1:-1, 1:-1, 1:-1]
+    ridge = V & (DT >= ndi.maximum_filter(DT, 3) - analyze.RIDGE_TOL) & (DT >= 1.0) & ~K
+    R = np.argwhere(ridge)
+    if len(R) == 0:
+        return None
+    if len(R) > SAMPLES:
+        R = R[rng.choice(len(R), SAMPLES, replace=False)]
+    rad = np.maximum(analyze.SHAPE_R * DT[tuple(R.T)], analyze.SHAPE_MINR)
+    kind, vec = [], []
+    for p, r in zip(R, rad):
+        ri = int(math.ceil(r))
+        a = np.maximum(p - ri, 0)
+        b = np.minimum(p + ri + 1, V.shape)
+        sub = V[a[0]:b[0], a[1]:b[1], a[2]:b[2]]
+        g = np.indices(sub.shape).reshape(3, -1).T + a - p
+        ball = (np.sum(g * g, 1) <= r * r).reshape(sub.shape) & sub
+        lab, _ = ndi.label(ball, np.ones((3, 3, 3)))
+        c = tuple(p - a)
+        q = np.argwhere(lab == lab[c]) + a - p if lab[c] else np.zeros((1, 3))
+        e, Ev = np.linalg.eigh(np.cov(q.T) if len(q) > 3 else np.eye(3))
+        s = np.sqrt(np.maximum(e[::-1], 1e-12))
+        Ev = Ev[:, ::-1]
+        if s[1] / s[0] < ROD_T:
+            kind.append('rod'); vec.append(Ev[:, 0])
+        elif s[2] / s[1] < PLATE_T:
+            kind.append('plate'); vec.append(Ev[:, 2])
+        else:
+            kind.append('blob'); vec.append(np.zeros(3))
+    kind = np.array(kind)
+    nb = cKDTree(R).query(R, min(analyze.SMOOTH_K, len(R)))[1]
+    codes = np.searchsorted(['blob', 'plate', 'rod'], kind)
+    votes = np.stack([(codes[nb] == c).sum(1) for c in range(3)], 1)
+    kind = np.array(['blob', 'plate', 'rod'])[np.argmax(votes, 1)]
+    vec = np.where((kind == 'blob')[:, None], 0.0, np.array(vec))
+    return dict(DT=DT, R=R, kind=kind, vec=vec)
+
+
