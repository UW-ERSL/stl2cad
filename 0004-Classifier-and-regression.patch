+"""Classification regression: every case with a truth.json (or an entry in TRUTH below), in variants.
+
+Variants: as given; two random rotations; 30 deg about the x and y axes; units m (x 0.001) and in (/ 25.4);
+voxel resolution 150 and 300 (classify.RES is 200). A case passes when every variant gives its type.
+
+Usage (from to/testbed/):  python run_classify.py [DIR ...]      (default ../../testbed/exact)
+Writes classify_report.txt in the first DIR.
+"""
+import glob, json, os, sys, time
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))
+import analyze, classify
+
+VARIANTS = [('as given', None, 1.0, None), ('rotation 1', 'r1', 1.0, None), ('rotation 2', 'r2', 1.0, None),
+            ('30 deg x, y', 'xy', 1.0, None), ('m', None, 1e-3, None), ('in', None, 1 / 25.4, None),
+            ('res 150', None, 1.0, 150), ('res 300', None, 1.0, 300)]
+
+
+def rotation(code):
+    if code is None:
+        return np.eye(3)
+    if code == 'xy':
+        return Rotation.from_euler('xy', [30, 30], degrees=True).as_matrix()
+    return Rotation.random(random_state=int(code[1:])).as_matrix()
+
+
+def run(case, truth):
+    fd, ft = analyze.find_pair(case)
+    dom0, to0 = analyze.load_stl(fd), analyze.load_stl(ft)
+    row = []
+    for name, rc, sc, res in VARIANTS:
+        R = rotation(rc)
+        r = classify.classify(dom0 @ R.T * sc, to0 @ R.T * sc, res or classify.RES)
+        row.append((name, r['type'], r['seconds'], r['reason']))
+    return row
+
+
+def main():
+    dirs = sys.argv[1:] or [os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'testbed', 'exact')]
+    out = []
+    for d in dirs:
+        for f in sorted(glob.glob(os.path.join(d, '**', 'truth.json'), recursive=True)):
+            case = os.path.dirname(f)
+            t = json.load(open(f))['type']
+            row = run(case, t)
+            ok = all(x[1] == t for x in row)
+            line = '%-28s %2d %-4s %s  (%.0f s)' % (os.path.basename(case), t, 'PASS' if ok else 'FAIL',
+                                                    ' '.join('%2d' % x[1] for x in row), sum(x[2] for x in row))
+            print(line, flush=True)
+            out.append(line)
+            for x in row:
+                if x[1] != t:
+                    m = '    %-12s -> %2d  %s' % (x[0], x[1], x[3])
+                    print(m, flush=True)
+                    out.append(m)
+    hdr = 'variants: ' + ', '.join(v[0] for v in VARIANTS)
+    open(os.path.join(dirs[0], 'classify_report.txt'), 'w').write(hdr + '\n' + '\n'.join(out) + '\n')
+
+
+if __name__ == '__main__':
+    main()
