+"""Classification of a TO part into the types of the reconstruction (lattices are out of scope):
+
+  1 extrude        constant 2D section through the full depth
+  2 stepped        height field with a few discrete depth levels
+  3 height field   one material interval per column, continuous depth
+  4 sandwich       two face layers joined by webs
+  5 axisymmetric   constant section revolved about an axis
+  6 plates         flat thin walls in several orientations
+  7 rod frame      straight members joined at nodes
+  8 curved rods    members bending along their length
+  9 shells         curved thin walls
+  10 solid mass    thick regions, no members
+  11 hybrid        two or more of 6-10 with a share >= HYBRID_SHARE
+
+Every test is computed and reported with its threshold; the type follows from all of them:
+
+  Frame and voxels: analyze.frame, analyze.voxelize, analyze.cleanup; pitch = max(diagonal / RES,
+  (box volume / MAX_VOX)^(1/3)).
+  Global tests, per frame axis a:
+    axisym  IoU of the TO with its revolved image about a (occupancy of each (r, z) ring >= 1/2), axis through
+            the domain's or the TO's centroid; >= AXISYM -> 5
+    slab    sqrt(TO area projected along a) / domain depth along a: the part is a sheet across a when
+            >= SLAB (a compact mass is a height field along any axis, but not a sheet)
+    columns analyze.constraint_tests: full, one interval, centred/anchored, step levels, two layers
+            extrude: full >= 0.8, one >= 0.9, sections IoU >= 0.9                      -> 1
+            sheet and one >= 0.95 and centred or anchored >= 0.9                       -> 2 (step levels >= 0.9) or 3
+            two layers >= 0.6 (axis: the largest area of two-layer columns)            -> 4
+  Precedence: 5, 1, 2/3, 4 (an axisymmetric part with a flat base is also a height field).
+  Otherwise, segments of the medial axis (analyze.local_shape, segments, describe): rod, plate, blob; a rod is
+  curved when the sagitta of a quadratic fit of its medial points (over its length) is >= CURVE x its radius;
+  a plate is a shell when not flat (analyze.FLAT). Joints (nodes, junctions, a mass smaller than the members it
+  touches) and fragments under FOLD count with their largest member neighbour; retained regions are left out.
+  Shares of rod 7, curved rod 8, plate 6, shell 9, mass 10: the largest kind's type when every other share is
+  < HYBRID_SHARE, else 11.
+
+Usage (from to/):  python classify.py CASE [CASE ...]      python classify.py --all DIR
+Writes CASE/results/classification.json.
+"""
+import argparse, glob, json, math, os, sys, time
+import numpy as np
+from scipy import ndimage as ndi
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import analyze
+
+TYPES = {1: 'extrude', 2: 'stepped', 3: 'height field', 4: 'sandwich', 5: 'axisymmetric', 6: 'plates',
+         7: 'rod frame', 8: 'curved rods', 9: 'shells', 10: 'solid mass', 11: 'hybrid'}
+KIND_TYPE = {'plate': 6, 'rod': 7, 'curved rod': 8, 'shell': 9, 'mass': 10}
+
+RES = 200
+MAX_VOX = 3e6
+AXISYM = 0.85
+SLAB = 2.0
+EXTRUDE = (0.8, 0.9, 0.9)       # full, one, section IoU
+HEIGHT = (0.95, 0.9)            # one, centred or anchored
+STEPPED = 0.9
+TWO = 0.6
+CURVE = 0.5
+HYBRID_SHARE = 0.15
+FOLD = 0.02             # fragments under this share of the part count with their largest member neighbour
+SAMPLES = 3000
+
+
+def grid(dom, to, res=RES):
+    pd, pt = dom.reshape(-1, 3), to.reshape(-1, 3)
+    lo, hi = np.minimum(pd.min(0), pt.min(0)), np.maximum(pd.max(0), pt.max(0))
+    h = max(np.linalg.norm(hi - lo) / res, (np.prod(hi - lo) / MAX_VOX) ** (1 / 3))
+    lo = lo - h
+    shape = tuple(int(x) for x in np.ceil((hi - lo) / h) + 1)
+    D, _ = analyze.voxelize(dom, lo, shape, h)
+    V, _ = analyze.voxelize(to, lo, shape, h)
+    V, clean = analyze.cleanup(V, D)
+    return D, V, lo, h, clean
+
+
+def axisym(V, D, ax):
+    """Best IoU of V with its revolved image about axis ax (through the domain's or the TO's centroid). Each ring
+    (radius bin, position along ax) is filled when V holds at least half of its lattice points, counted on the
+    whole ring (also outside the grid)."""
+    best = 0.0
+    u = [k for k in range(3) if k != ax]
+    P = np.argwhere(V)
+    for c in (np.argwhere(D).mean(0), P.mean(0)):
+        rb = np.round(np.hypot(P[:, u[0]] - c[u[0]], P[:, u[1]] - c[u[1]])).astype(int)
+        m = int(rb.max()) + 2
+        g = np.arange(-m, m + 1)                                      # lattice points per ring, whole plane
+        fx, fy = c[u[0]] % 1, c[u[1]] % 1
+        rr = np.round(np.hypot(g[:, None] - fx, g[None, :] - fy)).astype(int).ravel()
+        N = np.bincount(rr[rr <= m], minlength=m + 1)
+        key = rb * V.shape[ax] + P[:, ax]
+        o = np.bincount(key)
+        full = o[key] >= 0.5 * N[rb]                                  # V's points in filled rings
+        nf = np.flatnonzero(o >= 0.5 * N[np.arange(len(o)) // V.shape[ax]])
+        rev = int(N[nf // V.shape[ax]].sum())                         # points of the revolved image
+        inter = int(full.sum())
+        best = max(best, inter / max(len(P) + rev - inter, 1))
+    return best
+
+
+def area(V, ax, h):
+    return float(V.any(ax).sum() * h * h)
+
+
+def slab(V, D, ax, h):
+    proj = area(V, ax, h)
+    ext = np.flatnonzero(D.any(axis=tuple(k for k in range(3) if k != ax)))
+    depth = (ext[-1] - ext[0] + 1) * h
+    return float(math.sqrt(proj) / depth)
+
+
+def decide_global(G):
+    """Type from the global tests, with the test that decided and its margins; None when none applies."""
+    a5 = max(G, key=lambda g: g['axisym'])
+    if a5['axisym'] >= AXISYM:
+        return 5, 'axisymmetric about %s (IoU %.3f >= %.2f)' % (a5['axis'], a5['axisym'], AXISYM)
+    ex = [g for g in G if g['full'] >= EXTRUDE[0] and g['one'] >= EXTRUDE[1] and g['section_iou'] >= EXTRUDE[2]]
+    if ex:
+        g = max(ex, key=lambda g: g['full'])
+        return 1, 'extrude along %s (full %.3f, one %.3f, sections %.3f)' % (g['axis'], g['full'], g['one'],
+                                                                              g['section_iou'])
+    hf = [g for g in G if g['slab'] >= SLAB and g['one'] >= HEIGHT[0] and max(g['centred'], g['anchored']) >= HEIGHT[1]]
+    if hf:
+        g = max(hf, key=lambda g: g['one'])
+        t = 2 if g['step_levels'] >= STEPPED else 3
+        return t, '%s along %s (slab %.2f, one %.3f, %s %.3f, step levels %.3f)' % (
+            TYPES[t], g['axis'], g['slab'], g['one'], 'centred' if g['centred'] >= g['anchored'] else 'anchored',
+            max(g['centred'], g['anchored']), g['step_levels'])
+    sw = [g for g in G if g['two_layers'] >= TWO]
+    if sw:                                   # the axis whose two layers cover the largest area (the face sheets)
+        g = max(sw, key=lambda g: g['two_layers'] * g['area'])
+        return 4, 'sandwich across %s (two layers %.3f of the columns)' % (g['axis'], g['two_layers'])
+    return None, None
+
+
+def segments3d(V, D, lo, h, diag, seed=0):
+    rng = np.random.default_rng(seed)
+    analyze.MEDIAL_SAMPLES = SAMPLES
+    K, _ = analyze.retained(V, D, h, diag)
+    sh = analyze.local_shape(V, K, rng)
+    if sh is None:
+        return [dict(id=1, kind='retained', share=1.0)]
+    L, info = analyze.segments(V, K, sh)
+    segs = analyze.describe(L, info, V, D, sh, lo, h)
+    DT = sh['DT']
+    ridge = V & (DT >= ndi.maximum_filter(DT, 3) - analyze.RIDGE_TOL) & (DT >= 1.0)
+    rl, rp, rr = L[ridge], np.argwhere(ridge) * h, DT[ridge] * h
+    for s in segs:                           # curvature: sagitta of a quadratic fit of the medial points, in radii
+        if s['kind'] not in ('rod', 'curved rod'):
+            continue
+        P, r = rp[rl == s['id']], rr[rl == s['id']]
+        c = P.mean(0)
+        a = np.linalg.eigh(np.cov((P - c).T))[1][:, -1]
+        t = (P - c) @ a
+        d = (P - c) - np.outer(t, a)
+        if len(t) < 8 or np.ptp(t) <= 0:
+            continue
+        T = np.stack([np.ones_like(t), t, t * t], 1)
+        b2 = np.linalg.lstsq(T, d, rcond=None)[0][2]
+        sag = float(np.linalg.norm(b2) * (np.ptp(t) / 2) ** 2)
+        s['sagitta'] = round(sag, 4)
+        s['curvature'] = round(sag / max(float(np.median(r)), h), 3)
+        s['kind'] = 'curved rod' if s['curvature'] >= CURVE else 'rod'
+    return segs
+
+
+def decide_3d(segs):
+    """Shares of the member kinds. Joints (node, junction, and a mass smaller than the members it touches) and
+    fragments under FOLD of the part count with their largest member neighbour."""
+    by = {s['id']: s for s in segs}
+    member = ('rod', 'curved rod', 'plate', 'shell')
+    eff = {}
+    for s in sorted(segs, key=lambda s: -s['share']):
+        k = s['kind']
+        if k == 'retained':
+            continue
+        nb = [by[i] for i in s['neighbours'] if i in by and by[i]['kind'] in member]
+        joint = k in ('node', 'junction') or (k == 'mass' and nb and s['share'] <= sum(n['share'] for n in nb))
+        if (joint or s['share'] < FOLD) and nb:
+            k = max(nb, key=lambda n: n['share'])['kind']
+        elif k in ('node', 'junction'):
+            k = s['joins']
+        eff[s['id']] = k
+    share = {}
+    for i, k in eff.items():
+        share[k] = share.get(k, 0) + by[i]['share']
+    tot = sum(share.values())
+    if tot == 0:
+        return 10, 'retained regions only', {}
+    share = {k: round(v / tot, 3) for k, v in share.items()}
+    top = max(share, key=share.get)
+    txt = ', '.join('%s %.0f %%' % (k, 100 * v) for k, v in sorted(share.items(), key=lambda x: -x[1]))
+    if all(v < HYBRID_SHARE for k, v in share.items() if k != top):
+        return KIND_TYPE[top], txt, share
+    return 11, txt, share
+
+
+def classify(dom_tris, to_tris, res=RES):
+    t0 = time.time()
+    Rf, dev = analyze.frame(dom_tris)
+    dom, to = dom_tris @ Rf, to_tris @ Rf
+    D, V, lo, h, clean = grid(dom, to, res)
+    diag = float(np.linalg.norm(np.ptp(dom.reshape(-1, 3), 0)))
+    G = analyze.constraint_tests(V, D)
+    for g, ax in zip(G, range(3)):
+        g['axisym'] = round(axisym(V, D, ax), 3)
+        g['slab'] = round(slab(V, D, ax, h), 3)
+        g['area'] = round(area(V, ax, h), 6)
+    t, why = decide_global(G)
+    segs, share = None, None
+    if t is None:
+        segs = segments3d(V, D, lo, h, diag)
+        t, why, share = decide_3d(segs)
+    return dict(type=t, type_name=TYPES[t], reason=why, frame=dict(R=np.round(Rf, 6).tolist(),
+                deviation_deg=np.round(dev, 2).tolist()), pitch=h, shape=list(V.shape), cleanup=clean,
+                tests=G, shares=share, segments=segs, seconds=round(time.time() - t0, 1))
+
+
+def classify_case(case, res=RES, write=True):
+    fd, ft = analyze.find_pair(case)
+    r = classify(analyze.load_stl(fd), analyze.load_stl(ft), res)
+    r['case'] = os.path.relpath(case)
+    if write:
+        os.makedirs(os.path.join(case, 'results'), exist_ok=True)
+        json.dump(r, open(os.path.join(case, 'results', 'classification.json'), 'w'), indent=1, default=float)
+    return r
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('case', nargs='*'); ap.add_argument('--all'); ap.add_argument('--res', type=int, default=RES)
+    a = ap.parse_args()
+    cases = a.case or sorted(os.path.dirname(f) for f in
+                             glob.glob(os.path.join(a.all, '**', '*_finalIsoBinary.stl'), recursive=True))
+    for c in cases:
+        r = classify_case(c, a.res)
+        print('%-40s %2d %-13s %5.1f s  %s' % (r['case'], r['type'], r['type_name'], r['seconds'], r['reason']))
+
+
+if __name__ == '__main__':
+    main()
