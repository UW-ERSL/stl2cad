diff --git a/to/README.md b/to/README.md
index f3167b9..65b7137 100644
--- a/to/README.md
+++ b/to/README.md
@@ -160,3 +160,36 @@ extrude / height-field / two-layer tests along each frame axis; retained regions
 
     python analyze.py ../casestudies/cantilever/Case1
     python analyze.py --all ../casestudies
+
+## Routing (`route.py`) and the validation gate (`validate.py`)
+
+`route.py` reads `analysis.json` and picks the method for a case: `plates` (extrude, class 1), `heightfield`
+(classes 2a, 2b), `truss` (the planar-truss test passes), `frame` (rods in the part class; a candidate only, since
+`swframe.py` also needs the original's exact model and hubs), or `none`. The planar-truss test checks what
+`truss2d.fit` assumes: the domain is axis aligned (frame deviation below 1 deg), it fills at least 95 % of its box,
+the TO has an axis-aligned mirror plane (score at least 0.9), and at least 80 % of the TO's medial material (3D
+skeleton, weighted by the square of the local radius) lies within 1.5 local radii plus one voxel of a box face
+plane. Lengths are relative to analyze's voxel pitch (diagonal / 300). Writes `CASE/results/route.json` with the
+command to run; the units in it are a guess from the size (m below a 1 m diagonal, else in).
+
+    python route.py --all ../casestudies
+
+`validate.py` checks a model (STEP or STL) against its TO on one voxel grid (TO diagonal / 250): one solid (several
+solids in the file must fuse into one); volume within 10 %; voxel overlap at least 70 % of the TO and of the model;
+the largest TO region more than one voxel from the model, and the largest model region more than one voxel from
+the TO, each at most 5 % of the TO volume; the SolidWorks script's stand-in part agrees with the CadQuery model
+(from `NAME_standin.log`). The TO is scaled to the model's units (factor among 1, 1000, 25.4 and inverses nearest
+in diagonal). `swtruss.py` runs it at the end and exits with 1 on FAIL; its SolidWorks script ends with a line
+`validation: PASS` or `FAIL: ...` (sketches fully defined, every link made, features and final volume as built).
+
+    python validate.py MODEL.step TO.stl --standin NAME_standin.log
+    python validate.py --all ../casestudies          # every CASE/results/*.step; writes validation.json
+
+On the case studies: the 18 cases route as plates 3, heightfield 5, truss 1 (cantilever Case 7), frame candidate 3
+(knuckle Case 3, stool Case 1, torsion cylinder), none 6 (GE bracket, cantilever Case 9,
+knuckle Cases 1 and 2, stool Cases 2 and 3). The face test separates Case 7 (89 %) from every other 3D case (65 %
+or less); the 80 % limit is set from these cases only. The 10 models in the results folders: 9 PASS; the knuckle
+Case 3 STEP FAILs (43 feature bodies whose fuse leaves 3 solids, +38 % volume), although its SolidWorks script
+agrees with its own reference on the stand-in. Case 7 passes with the least margin (overlap 75 %, largest extra
+region 4.7 %). Limits: the gate measures shape agreement with the TO, not structural performance; a missed member
+under 5 % of the TO volume passes; the thresholds are not yet tested on new geometry.
diff --git a/to/route.py b/to/route.py
new file mode 100644
index 0000000..6270fc0
--- /dev/null
+++ b/to/route.py
@@ -0,0 +1,136 @@
+"""Route a case to the reconstruction method that applies to it, or flag it as having none.
+
+Reads CASE/results/analysis.json (analyze.py: frame, grid, symmetry, route, part class) and the case's two STLs.
+
+  extrude (class 1)        plates        run_plates.py
+  height field (2a, 2b)    heightfield   run_plates.py --mode heightfield
+  otherwise, the planar-truss test passes
+                           truss         swtruss.py (truss2d.py)
+  otherwise, rods (class 4 or 5 in the part class)
+                           frame         swframe.py; needs the original's exact model (stl2cad.cli); candidate only
+  otherwise                none
+
+Planar-truss test (what truss2d.fit assumes):
+  frame      the domain is axis aligned (frame deviation < FRAME_DEG): truss2d works in the global axes
+  box        the domain fills its bounding box >= BOX_FILL: the outlines are rectangles
+  mirror     an axis-aligned mirror plane of the TO, score >= MIRROR (analyze's symmetry, accepted or candidate)
+  faces      the material lies in the planes of the domain's box faces: of the medial voxels of the TO
+             (3D skeleton, local radius r from the distance transform), weighted by r^2, a share >= FACES lies
+             within FACE_R x r + one voxel of a box face plane
+
+The voxel grid is analyze's (pitch = diagonal / 300), so every length above is relative to the part.
+Writes CASE/results/route.json. Units for the commands: m when the domain diagonal is below 1, else in
+(a guess from the size; check it).
+
+Usage (from to/):  python route.py CASE [CASE ...]      python route.py --all ../casestudies
+"""
+import argparse, glob, json, os, sys
+import numpy as np
+from scipy import ndimage as ndi
+from skimage.morphology import skeletonize
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import analyze
+
+FRAME_DEG = 1.0
+BOX_FILL = 0.95
+MIRROR = 0.9
+FACES = 0.8             # Case 7 (a face truss): 0.89; every other 3D case: 0.65 or less
+FACE_R = 1.5
+
+
+def face_share(case, rep):
+    """Share (r^2 weighted) of the TO's medial voxels within FACE_R r + h of a plane of the domain's box,
+    and the share per plane (axis, side)."""
+    fd, ft = analyze.find_pair(case)
+    R = np.array(rep['frame']['R'])
+    dom, to = analyze.load_stl(fd) @ R, analyze.load_stl(ft) @ R
+    g = rep['grid']
+    lo, h, shape = np.array(g['lo']), g['pitch'], tuple(g['shape'])
+    D, _ = analyze.voxelize(dom, lo, shape, h)
+    V, _ = analyze.voxelize(to, lo, shape, h)
+    V, _ = analyze.cleanup(V, D)
+    S = skeletonize(V) > 0
+    r = ndi.distance_transform_edt(V)[S] * h
+    p = lo + (np.argwhere(S) + 0.5) * h
+    pd = dom.reshape(-1, 3)
+    box = np.stack([pd.min(0), pd.max(0)])                       # (2, 3): low and high faces
+    d = np.abs(p[:, None, :] - box[None])                  # (n, 2 sides, 3 axes)
+    on = d <= (FACE_R * r + h)[:, None, None]
+    w = r ** 2
+    share = float(w[on.any(axis=(1, 2))].sum() / w.sum())
+    per = {'%s%s' % ('-+'[s], 'xyz'[a]): round(float(w[on[:, s, a]].sum() / w.sum()), 3)
+           for s in range(2) for a in range(3)}
+    return share, per, int(S.sum())
+
+
+def truss_test(case, rep):
+    sym = rep['symmetry']
+    mir = [m for m in sym['mirrors'] + sym['candidates'] if m['kind'] == 'mirror'
+           and max(np.abs(m['vector'])) > 0.999]
+    ms = max([m['to'] for m in mir], default=0.0)
+    dev = max(rep['frame']['deviation_deg'])
+    fill = rep['domain']['fill_of_box']
+    share, per, n = face_share(case, rep)
+    C = [('frame', dev < FRAME_DEG, 'frame deviation %.1f deg (limit %.0f)' % (dev, FRAME_DEG)),
+         ('box', fill >= BOX_FILL, 'domain fills %.0f %% of its box (limit %.0f %%)' % (100 * fill, 100 * BOX_FILL)),
+         ('mirror', ms >= MIRROR, 'best axis-aligned mirror plane %.2f, normal %s (limit %.2f)'
+          % (ms, 'xyz'[int(np.argmax(np.abs(max(mir, key=lambda m: m['to'])['vector'])))], MIRROR) if mir else
+          'no axis-aligned mirror plane (limit %.2f)' % MIRROR),
+         ('faces', share >= FACES, 'medial material on the box faces %.0f %% (limit %.0f %%; %d medial voxels; %s)'
+          % (100 * share, 100 * FACES, n, ', '.join('%s %.0f %%' % (k, 100 * v) for k, v in per.items() if v >= 0.01)))]
+    return all(c[1] for c in C), C
+
+
+def route_case(case):
+    rep = json.load(open(os.path.join(case, 'results', 'analysis.json')))
+    fd, ft = analyze.find_pair(case)
+    units = 'm' if np.linalg.norm(rep['domain']['size']) < 1 else 'in'
+    rt, cls = rep['route']['route'], rep['part_class']
+    name = os.path.basename(os.path.normpath(case)).lower()
+    args = '%s %s NAME --units %s' % (os.path.relpath(fd), os.path.relpath(ft), units)
+    out = dict(case=os.path.relpath(case), analyze_route=rt, part_class=cls, units_guess=units, truss_test=None)
+    if rt == 'extrude':
+        out.update(route='plates', command='python run_plates.py ' + args)
+    elif rt == 'height field':
+        out.update(route='heightfield', command='python run_plates.py %s --mode heightfield' % args)
+    else:
+        ok, C = truss_test(case, rep)
+        out['truss_test'] = [dict(check=n, ok=bool(o), text=t) for n, o, t in C]
+        if ok:
+            out.update(route='truss', command='python swtruss.py %s --detail 4' % args)
+        elif any(k in cls.replace('(', ' ').replace('+', ' ').split() for k in ('4', '5')):
+            out.update(route='frame', command='python swframe.py EXACT_ORIGINAL.py %s %s --units %s --detail 3'
+                       % (os.path.relpath(ft), 'NAME', units),
+                       note='candidate: rods in the part class; swframe needs the exact model of the original '
+                            '(stl2cad.cli) and hubs; not tested for applicability')
+        else:
+            out.update(route='none', note='no reconstruction method applies (part class %s)' % cls)
+    json.dump(out, open(os.path.join(case, 'results', 'route.json'), 'w'), indent=1)
+    return out
+
+
+def report(case, r):
+    L = ['%s: %s  (analyze: %s, class %s)' % (case, r['route'], r['analyze_route'], r['part_class'])]
+    for c in r['truss_test'] or []:
+        L.append('  truss %-6s %-4s %s' % (c['check'], 'ok' if c['ok'] else 'no', c['text']))
+    if r.get('note'):
+        L.append('  ' + r['note'])
+    return '\n'.join(L)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('case', nargs='*'); ap.add_argument('--all')
+    a = ap.parse_args()
+    cases = a.case or sorted(os.path.dirname(f) for f in
+                             glob.glob(os.path.join(a.all, '**', '*_finalIsoBinary.stl'), recursive=True))
+    for c in cases:
+        if not os.path.exists(os.path.join(c, 'results', 'analysis.json')):
+            print('%s: no analysis.json (run analyze.py first)' % c)
+            continue
+        print(report(os.path.relpath(c, a.all) if a.all else c, route_case(c)))
+
+
+if __name__ == '__main__':
+    main()
