diff --git a/casestudies/cantilever/Case7/results/cantilever7_d4_solidworks.py b/casestudies/cantilever/Case7/results/cantilever7_d4_solidworks.py
index 924b75b..7bdc256 100644
--- a/casestudies/cantilever/Case7/results/cantilever7_d4_solidworks.py
+++ b/casestudies/cantilever/Case7/results/cantilever7_d4_solidworks.py
@@ -459,11 +459,12 @@ def boss_checked(m, sk, S, i, name):
 def build():
     m = new_part()
     ok = True
-    links, depth = [], []
+    links, depth, defs = [], [], []
     for S in STRUCTS:
         sk, lk = truss_sketch(m, S)
         links += lk
-        print(f"{S['name']} sketch: {status(sk)}; {LOG['rels']} relations, {LOG['dims']} dimensions so far")
+        defs.append((S["name"], status(sk)))
+        print(f"{S['name']} sketch: {defs[-1][1]}; {LOG['rels']} relations, {LOG['dims']} dimensions so far")
         for i in range(len(S["faces"])):
             name = f"{S['name']} face {i + 1}" if len(S["faces"]) > 1 else S["name"]
             f = boss_checked(m, sk, S, i, name)
@@ -520,6 +521,16 @@ def build():
         print("  not linked (value differs): " + t)
     print(f"independent parameters: {N_PARAMS}")
     print("all features " + ("agree" if ok else "do NOT all agree"))
+    # validation: sketches fully defined, every link made, the features and the final volume as built
+    bad = ("under defined", "over defined", "no solution", "invalid solution")
+    probs = [f"{n} sketch {st}" for n, st in defs if st in bad]
+    probs += [f"{len(LOG['eqs_skipped'])} link(s) left out"] if LOG["eqs_skipped"] else []
+    probs += [f"{len(LOG['eqs_failed'])} equation(s) failed"] if LOG["eqs_failed"] else []
+    probs += [] if ok else ["features disagree"]
+    probs += [] if abs(v - ev) <= TOL * ev else [f"volume after the equations {v - ev:+.3f} mm^3"]
+    unk = [n for n, st in defs if st != "fully defined" and st not in bad]
+    print("validation: " + ("PASS" if not probs else "FAIL: " + "; ".join(probs))
+          + (f" (sketch status not available: {', '.join(unk)})" if unk else ""))
     return m
 
 
