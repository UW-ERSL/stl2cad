@@ -0,0 +1,155 @@
+"""Validation gate: is a reconstructed model an acceptable stand-in for its TO result? Route independent.
+
+The model (STEP, or STL) and the TO STL are voxelized on one grid, pitch = TO diagonal / RES. Checks:
+
+  solids     the model is one solid (several solids in the file: one after a fuse; the voxels and the volume
+             are then those of their union)
+  volume     model volume within VOLUME of the TO's
+  overlap    |M & T| / |T| and |M & T| / |M| both >= OVERLAP (M, T: model and TO voxels)
+  missed     the largest connected TO region more than one voxel from the model, as a share of the TO,
+             is <= REGION (a member or plate left out)
+  extra      the same for model regions more than one voxel from the TO (material the TO does not have)
+  stand-in   the SolidWorks script ran on the stand-in (swmock) and its part agrees with the CadQuery model
+             (read from NAME_standin.log; volumes within STANDIN)
+
+The TO is scaled to the model's units: the factor among 1, 1000 (m to mm), 25.4 (in to mm) and their inverses
+whose diagonal is nearest to the model's. Both are compared in the coordinates they were written in.
+
+Usage (from to/):  python validate.py MODEL.step TO.stl [--standin NAME_standin.log]
+                   python validate.py --all ../casestudies      (every results/*.step; writes validation.json)
+"""
+import argparse, glob, json, os, re, sys
+import numpy as np
+from scipy import ndimage as ndi
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import analyze
+
+RES = 250
+VOLUME = 0.10
+OVERLAP = 0.70
+REGION = 0.05
+STANDIN = 1e-3
+SCALES = (1.0, 1000.0, 25.4, 1e-3, 1 / 25.4)
+
+
+def triangles(path):
+    """Triangles (n, 3, 3) per solid of a STEP or STL file, and the number of solids after a fuse (OCC)."""
+    if path.lower().endswith(('.step', '.stp')):
+        import cadquery as cq
+        s = cq.importers.importStep(path).val()
+        S = s.Solids()
+        n = 1 if len(S) == 1 else len(S[0].fuse(*S[1:]).clean().Solids())
+        out = []
+        for x in S:
+            v, f = x.tessellate(1e-3 * s.BoundingBox().DiagonalLength, 0.2)
+            out.append(np.array([p.toTuple() for p in v])[np.array(f)])
+        return out, len(S), n
+    import trimesh
+    m = trimesh.load(path, force='mesh')
+    P = m.split(only_watertight=False)
+    return [p.vertices[p.faces] for p in P], len(P), len(P)
+
+
+def tri_volume(T):
+    return abs(float(np.sum(np.einsum('ij,ij->i', T[:, 0], np.cross(T[:, 1], T[:, 2]))) / 6))
+
+
+def standin(log):
+    """(ok, line) from a stand-in log: the last 'stand-in:' line; volumes (and the difference) within STANDIN."""
+    if not os.path.exists(log):
+        return None, 'no stand-in log'
+    L = [l for l in open(log, errors='ignore').read().splitlines() if l.startswith('stand-in:')]
+    if not L:
+        return False, 'the stand-in did not finish'
+    v = re.search(r'volume ([0-9.]+), reference ([0-9.]+)', L[-1])
+    d = re.search(r'difference volume ([0-9.]+)', L[-1])
+    if not v:
+        return False, L[-1]
+    a, b = float(v.group(1)), float(v.group(2))
+    ok = abs(a - b) <= STANDIN * b and (d is None or float(d.group(1)) <= STANDIN * b)
+    return ok, L[-1]
+
+
+def validate(model, to_stl, log=None, res=RES):
+    """Checks of one model against its TO. Returns dict(ok, checks=[(name, ok, text)], ...)."""
+    Ms, nfile, nsol = triangles(model)
+    M = np.vstack(Ms)
+    T = analyze.load_stl(to_stl)
+    dm = np.linalg.norm(np.ptp(M.reshape(-1, 3), 0))
+    dt = np.linalg.norm(np.ptp(T.reshape(-1, 3), 0))
+    sc = min(SCALES, key=lambda s: abs(np.log(dm / (s * dt))))
+    T = T * sc
+    pts = np.vstack([M.reshape(-1, 3), T.reshape(-1, 3)])
+    h = dt * sc / res
+    lo = pts.min(0) - 2 * h
+    shape = tuple(int(x) for x in np.ceil((pts.max(0) + 2 * h - lo) / h))
+    Vm = np.zeros(shape, bool)
+    for X in Ms:                           # several solids: the union of their voxels
+        Vm |= analyze.voxelize(X, lo, shape, h)[0]
+    Vt, _ = analyze.voxelize(T, lo, shape, h)
+    ball = ndi.generate_binary_structure(3, 3)
+    nm, nt, both = int(Vm.sum()), int(Vt.sum()), int((Vm & Vt).sum())
+
+    def largest(A, B):                     # largest region of A farther than one voxel from B, share of the TO
+        lab, n = ndi.label(A & ~ndi.binary_dilation(B, ball), ball)
+        return float(np.bincount(lab.ravel())[1:].max() / nt) if n else 0.0
+    vt = tri_volume(T)
+    vm = tri_volume(M) if len(Ms) == 1 else vt * nm / nt     # several solids: the voxel volume of their union,
+    #                                                          # with the TO's ratio of exact to voxel volume
+    miss, extra = largest(Vt, Vm), largest(Vm, Vt)
+    C = [('solids', nsol == 1, '%d solid(s)' % nsol if nfile == 1 else
+          '%d solids in the file, %d after a fuse' % (nfile, nsol)),
+         ('volume', abs(vm / vt - 1) <= VOLUME, 'model %.0f, TO %.0f (%+.1f %%; limit %.0f %%)'
+          % (vm, vt, 100 * (vm / vt - 1), 100 * VOLUME)),
+         ('overlap', min(both / max(nt, 1), both / max(nm, 1)) >= OVERLAP,
+          'of the TO %.0f %%, of the model %.0f %% (limit %.0f %%)'
+          % (100 * both / max(nt, 1), 100 * both / max(nm, 1), 100 * OVERLAP)),
+         ('missed', miss <= REGION, 'largest TO region not modelled %.1f %% of the TO (limit %.0f %%)'
+          % (100 * miss, 100 * REGION)),
+         ('extra', extra <= REGION, 'largest model region outside the TO %.1f %% of the TO (limit %.0f %%)'
+          % (100 * extra, 100 * REGION))]
+    if log is not None:
+        ok, txt = standin(log)
+        C.append(('stand-in', bool(ok), txt))
+    return dict(model=os.path.basename(model), to=os.path.basename(to_stl), scale=sc, pitch=h,
+                ok=all(c[1] for c in C), checks=C)
+
+
+def report(r):
+    L = ['%s against %s: %s' % (r['model'], r['to'], 'PASS' if r['ok'] else 'FAIL')]
+    L += ['  %-9s %-4s %s' % (n, 'ok' if ok else 'FAIL', t) for n, ok, t in r['checks']]
+    return '\n'.join(L)
+
+
+def case_models(case):
+    """The models in CASE/results (STEP files named like the case's outputs; out_* folders excluded)."""
+    return sorted(glob.glob(os.path.join(case, 'results', '*.step')))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('model', nargs='?'); ap.add_argument('to', nargs='?')
+    ap.add_argument('--standin'); ap.add_argument('--all'); ap.add_argument('--res', type=int, default=RES)
+    a = ap.parse_args()
+    if not a.all:
+        r = validate(a.model, a.to, a.standin, a.res)
+        print(report(r))
+        sys.exit(0 if r['ok'] else 1)
+    for f in sorted(glob.glob(os.path.join(a.all, '**', '*_finalIsoBinary.stl'), recursive=True)):
+        case = os.path.dirname(f)
+        ms = case_models(case)
+        if not ms:
+            print('%s: no model' % os.path.relpath(case, a.all))
+            continue
+        out = []
+        for m in ms:
+            log = os.path.splitext(m)[0] + '_standin.log'
+            r = validate(m, f, log, a.res)
+            print('%s: %s' % (os.path.relpath(case, a.all), report(r)))
+            out.append(r)
+        json.dump(out, open(os.path.join(case, 'results', 'validation.json'), 'w'), indent=1)
+
+
+if __name__ == '__main__':
+    main()
