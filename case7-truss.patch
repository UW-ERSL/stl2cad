+def mass(m):
+    m.ForceRebuild3(False)
+    mp = call0(m.Extension, "CreateMassProperty")
+    if mp is None:
+        return 0.0, (0.0, 0.0, 0.0)
+    return mp.Volume / MM ** 3, tuple(c / MM for c in mp.CenterOfMass)
