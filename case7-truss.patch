+def sel(m, objs):
+    m.ClearSelection2(True)
+    ok = True
+    for k, o in enumerate(objs):
+        if o == "ORIGIN":
+            ok = ok and m.Extension.SelectByID2("Point1@Origin", "EXTSKETCHPOINT", 0, 0, 0, k > 0, 0, NOTHING, 0)
+        else:
+            ok = ok and o is not None and o.Select4(k > 0, NOTHING)
