+        print(f"{step}: NOT MADE")
+        return False
+    v, c = mass(m)
+    ok = abs(v - ev) <= TOL * ev
+    print(f"{step}: volume {v:.3f} mm^3 (expected {ev:.3f}); centre {math.dist(c, ec):.4f} mm off -> "
+          f"{'OK' if ok else 'DIFFERS'}")
+    return ok
